# Copia este archivo como .env y completa tu clave de Google AI Studio.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Si el modelo configurado ya no existe, el backend elige un Flash vigente.
GEMINI_MODEL=gemini-1.5-flash

# Servidor: 0.0.0.0 permite acceso desde el iPhone en la misma red local.
HOST=0.0.0.0
PORT=8000

# Ruta opcional a los pesos de la CNN (por ejemplo ./models/sky_cnn.pt).
# Si se deja vacío se usa el clasificador heurístico de respaldo.
VISION_MODEL_PATH=
