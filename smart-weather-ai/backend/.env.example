# Copia este archivo como .env y completa tu clave de Google AI Studio.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Si el modelo configurado ya no existe, el backend elige un Flash vigente.
GEMINI_MODEL=gemini-1.5-flash

# Servidor: 0.0.0.0 permite acceso desde el iPhone en la misma red local.
HOST=0.0.0.0
PORT=8000

# Allowlist CORS en formato JSON. Añade aquí tu IP LAN o túnel HTTPS.
CORS_ORIGINS=["http://localhost:5173"]

# Token obligatorio para /api/admin/*. Genera uno con:
#   openssl rand -hex 32
# Si se deja vacío, el panel de administración queda deshabilitado.
ADMIN_TOKEN=

# Ruta opcional a los pesos de la CNN (por ejemplo ./models/sky_cnn.pt).
# Si se deja vacío se usa el clasificador heurístico de respaldo.
VISION_MODEL_PATH=

# Base de datos. Por defecto backend/smart_weather.db (SQLite).
# DATABASE_URL=sqlite:///./smart_weather.db
