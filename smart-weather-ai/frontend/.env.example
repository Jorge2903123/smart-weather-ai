# URL del backend FastAPI.
# En la computadora:
VITE_API_URL=http://localhost:8000

# Desde un iPhone en la misma red WiFi usa la IP LAN de tu equipo:
# VITE_API_URL=http://192.168.1.50:8000
#
# Con un túnel HTTPS (recomendado para micrófono en Safari iOS):
# VITE_API_URL=https://tu-subdominio.trycloudflare.com

# PIN del panel de administración (protección básica en el cliente).
VITE_ADMIN_PIN=admin123
